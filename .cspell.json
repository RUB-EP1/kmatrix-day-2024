{
  "allowCompoundWords": true,
  "dictionaries": ["latex", "physics", "python"],
  "enableFiletypes": [
    "git-commit",
    "github-actions-workflow",
    "julia",
    "jupyter",
    "python"
  ],
  "flagWords": [
    "analyse",
    "colour",
    "comparision",
    "favour",
    "flavour",
    "hte",
    "optimise",
    "paramater",
    "parmater",
    "transision",
    "transisions"
  ],
  "ignorePaths": [
    "*.bib",
    "*.csl",
    "*.css",
    "*.ico",
    "*.svg",
    ".cspell.json",
    ".editorconfig",
    ".envrc",
    ".gitattributes",
    ".github/",
    ".gitignore",
    ".pre-commit-config.yaml",
    ".prettierignore",
    ".prettierrc.yaml",
    ".vscode/",
    "LICENSE",
    "Manifest.toml",
    "Project.toml",
    "docs/K-matrix.jl",
    "pixi.lock",
    "pixi.toml",
    "pyproject.toml"
  ],
  "ignoreWords": [
    "aslatex",
    "axhline",
    "axvline",
    "cbar",
    "cmap",
    "eigvals",
    "iminuit",
    "ipynb",
    "mathbb",
    "mathrm",
    "nbsp",
    "ncols",
    "ndarray",
    "nocite",
    "nrows",
    "pcolormesh",
    "sharey",
    "vlines",
    "vmax",
    "vmin",
    "xlabel",
    "ylabel",
    "ylim",
    "yticks"
  ],
  "language": "en-US",
  "overrides": [
    {
      "dictionaries": ["julia", "latex", "physics"],
      "filename": "**/*.jl",
      "languageId": "julia"
    }
  ],
  "useGitignore": true,
  "version": "0.2",
  "words": [
    "analyticity",
    "cmax",
    "cmin",
    "Colab",
    "ComPWA",
    "Indico",
    "ipympl",
    "Kallen",
    "lambdify",
    "Mikhasenko",
    "mystnb",
    "Pixi",
    "prek",
    "P\u00f6pping",
    "Remco",
    "Tombi",
    "unphysical",
    "xaxis",
    "xreplace",
    "yaxis",
    "zaxis",
    "Zeynep"
  ]
}
